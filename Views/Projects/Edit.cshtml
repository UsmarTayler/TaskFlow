@model TaskFlow.ViewModels.EditProjectViewModel
@using TaskFlow.Models

@{
    ViewData["Title"] = "Edit Project";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Detail" asp-route-id="@Model.ProjectId"
           class="text-muted small text-decoration-none">← Back to Project</a>
        <h3 class="mt-2 mb-4">Edit Project</h3>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProjectId" />
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label fw-semibold"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <a asp-action="Detail" asp-route-id="@Model.ProjectId"
                           class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

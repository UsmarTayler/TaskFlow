@model TaskFlow.ViewModels.JoinOrganisationViewModel

@{
    ViewData["Title"] = "Join Organisation";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <a asp-action="Index" class="text-muted small text-decoration-none">← Organisations</a>
        <h3 class="mt-2 mb-2">Join an Organisation</h3>
        <p class="text-muted mb-4">Ask a team member or admin for your organisation's 6-character invite code.</p>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Join" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="InviteCode" class="form-label fw-semibold"></label>
                        <input asp-for="InviteCode" class="form-control font-monospace text-uppercase"
                               maxlength="6" placeholder="e.g. ACM3X9"
                               style="letter-spacing:0.2em; font-size:1.2rem" />
                        <span asp-validation-for="InviteCode" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Join</button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-muted small text-center mt-3">
            Want to create your own? <a asp-action="Create">Start a new organisation</a>.
        </p>
    </div>
</div>

@section Scripts {
<script>
// Auto-uppercase the invite code as the user types
document.querySelector('input[name="InviteCode"]')
    ?.addEventListener('input', e => e.target.value = e.target.value.toUpperCase());
</script>
    <partial name="_ValidationScriptsPartial" />
}

@model TaskFlow.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h3 class="mb-0">User Management</h3>
    <span class="badge bg-secondary fs-6">@Model.Users.Count users</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Email</th>
                        <th>Current Role(s)</th>
                        <th class="pe-3">Change Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@user.FullName</td>
                            <td class="text-muted small">@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    var badge = role == "Admin"          ? "bg-danger"
                                              : role == "ProjectManager" ? "bg-primary"
                                              : "bg-success";
                                    <span class="badge @badge me-1">@role</span>
                                }
                                @if (!user.Roles.Any()) { <span class="text-muted small">No role</span> }
                            </td>
                            <td class="pe-3">
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="newRole" class="form-select form-select-sm" style="max-width:160px">
                                        @foreach (var role in Model.AllRoles)
                                        {
                                            if (user.Roles.Contains(role))
                                            { <option value="@role" selected>@role</option> }
                                            else
                                            { <option value="@role">@role</option> }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary btn-sm"
                                            onclick="return confirm('Change role for @user.FullName?')">
                                        Save
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

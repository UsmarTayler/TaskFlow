@model TaskFlow.ViewModels.CreateWorkItemViewModel
@using TaskFlow.Models

@{
    ViewData["Title"] = "Add Task";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-controller="Projects" asp-action="Detail" asp-route-id="@Model.ProjectId"
           class="text-muted small text-decoration-none">← Back to @ViewBag.ProjectName</a>
        <h3 class="mt-2 mb-4">Add Work Item</h3>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProjectId" />
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Implement OAuth2 login" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="What needs to be done?"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label fw-semibold"></label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<ItemType>()" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold"></label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label fw-semibold"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="AssignedToId" class="form-label fw-semibold"></label>
                        <select asp-for="AssignedToId" class="form-select">
                            <option value="">— Unassigned —</option>
                            @foreach (var dev in (IEnumerable<TaskFlow.Models.ApplicationUser>)ViewBag.Developers)
                            {
                                <option value="@dev.Id">@dev.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-controller="Projects" asp-action="Detail" asp-route-id="@Model.ProjectId"
                           class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Add Task</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

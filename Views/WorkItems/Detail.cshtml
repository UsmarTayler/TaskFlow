@model TaskFlow.Models.WorkItem
@using TaskFlow.Models

@{
    ViewData["Title"] = Model.Title;
    var pBadge = Model.Priority == Priority.Critical ? "bg-danger"
               : Model.Priority == Priority.High     ? "bg-warning text-dark"
               : Model.Priority == Priority.Medium   ? "bg-info text-dark"
               : "bg-secondary";
    var sBadge = Model.Status == ItemStatus.Done       ? "bg-success"
               : Model.Status == ItemStatus.InProgress ? "bg-primary"
               : Model.Status == ItemStatus.InReview   ? "bg-info text-dark"
               : "bg-light text-dark border";
    var sLabel = Model.Status == ItemStatus.InProgress ? "In Progress"
               : Model.Status == ItemStatus.InReview   ? "In Review"
               : Model.Status.ToString();
}

<a asp-controller="Projects" asp-action="Detail" asp-route-id="@Model.ProjectId"
   class="text-muted small text-decoration-none">← @Model.Project?.Name</a>

<div class="row mt-3 g-4">
    <!-- ── Main info ──────────────────────────────────────────────────────────── -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-light text-dark border">@Model.Type</span>
                    <span class="badge @pBadge">@Model.Priority</span>
                    <span class="badge @sBadge">@sLabel</span>
                    @if (Model.IsOverdue) { <span class="badge bg-danger">Overdue</span> }
                </div>

                <div class="d-flex align-items-start justify-content-between mb-3">
                    <h4 class="mb-0">@Model.Title</h4>
                    @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                    {
                        <div class="d-flex gap-2 ms-3 flex-shrink-0">
                            <a asp-action="Edit" asp-route-id="@Model.WorkItemId"
                               class="btn btn-outline-secondary btn-sm">✏ Edit</a>
                            <form asp-action="Delete" method="post"
                                  onsubmit="return confirm('Delete this work item? This cannot be undone.')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id"        value="@Model.WorkItemId" />
                                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">🗑 Delete</button>
                            </form>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic">No description provided.</p>
                }
            </div>
        </div>

        <!-- ── Update Status ──────────────────────────────────────────────────── -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-3">Update Status</h6>
                <form asp-controller="WorkItems" asp-action="UpdateStatus" method="post"
                      class="d-flex gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id"        value="@Model.WorkItemId" />
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <select name="status" class="form-select" style="max-width:180px">
                        @foreach (ItemStatus s in Enum.GetValues<ItemStatus>())
                        {
                            var label = s == ItemStatus.InProgress ? "In Progress"
                                      : s == ItemStatus.InReview   ? "In Review"
                                      : s.ToString();
                            if (s == Model.Status)
                            { <option value="@s" selected>@label</option> }
                            else
                            { <option value="@s">@label</option> }
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ── Sidebar ────────────────────────────────────────────────────────────── -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-3">Details</h6>
                <dl class="row small mb-0">
                    <dt class="col-5 text-muted">Project</dt>
                    <dd class="col-7">
                        <a asp-controller="Projects" asp-action="Detail" asp-route-id="@Model.ProjectId">
                            @Model.Project?.Name
                        </a>
                    </dd>

                    <dt class="col-5 text-muted">Assigned To</dt>
                    <dd class="col-7">@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>

                    <dt class="col-5 text-muted">Created By</dt>
                    <dd class="col-7">@(Model.CreatedBy?.FullName ?? "—")</dd>

                    <dt class="col-5 text-muted">Due Date</dt>
                    <dd class="col-7">@(Model.DueDate?.ToString("MMM d, yyyy") ?? "—")</dd>

                    <dt class="col-5 text-muted">Created</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>

                    <dt class="col-5 text-muted">Last Updated</dt>
                    <dd class="col-7">@Model.UpdatedAt.ToString("MMM d, yyyy")</dd>
                </dl>

                <!-- Reassign (PM/Admin only) -->
                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                {
                    <hr />
                    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Reassign</h6>
                    <form asp-controller="WorkItems" asp-action="Assign" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.WorkItemId" />
                        <select name="assignedToId" class="form-select form-select-sm mb-2">
                            <option value="">— Unassigned —</option>
                            @foreach (var dev in (IEnumerable<ApplicationUser>)ViewBag.Developers)
                            {
                                if (dev.Id == Model.AssignedToId)
                                { <option value="@dev.Id" selected>@dev.FullName</option> }
                                else
                                { <option value="@dev.Id">@dev.FullName</option> }
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Update Assignee</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── Comments ────────────────────────────────────────────────────────────── -->
@{
    var comments    = ViewBag.Comments as List<TaskFlow.Models.WorkItemComment> ?? new List<TaskFlow.Models.WorkItemComment>();
    var currentUser = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <h6 class="text-muted text-uppercase small fw-semibold mb-3">
            Comments <span class="badge bg-secondary">@comments.Count</span>
        </h6>

        @if (comments.Any())
        {
            @foreach (var c in comments)
            {
                var canDelete = c.AuthorId == currentUser || User.IsInRole("Admin") || User.IsInRole("ProjectManager");
                <div class="d-flex gap-3 mb-3">
                    <div class="avatar-circle flex-shrink-0" style="width:36px;height:36px;font-size:0.85rem">
                        @(c.Author?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="fw-semibold small">@(c.Author?.FullName ?? "Deleted user")</span>
                            <span class="text-muted" style="font-size:0.75rem">@c.CreatedAt.ToString("MMM d, yyyy HH:mm")</span>
                            @if (canDelete)
                            {
                                <form asp-action="DeleteComment" method="post" style="display:inline;margin-left:auto"
                                      onsubmit="return confirm('Delete this comment?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId"  value="@c.WorkItemCommentId" />
                                    <input type="hidden" name="workItemId" value="@Model.WorkItemId" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                                </form>
                            }
                        </div>
                        <div class="bg-light rounded p-2 small">@c.Body</div>
                    </div>
                </div>
            }
            <hr />
        }

        <!-- Add comment form -->
        <form asp-action="AddComment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="workItemId" value="@Model.WorkItemId" />
            <div class="d-flex gap-3">
                <div class="avatar-circle flex-shrink-0" style="width:36px;height:36px;font-size:0.85rem">
                    @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                </div>
                <div class="flex-grow-1">
                    <textarea name="body" class="form-control form-control-sm mb-2"
                              rows="2" placeholder="Leave a comment…"></textarea>
                    <button type="submit" class="btn btn-primary btn-sm">Comment</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ── Change History ──────────────────────────────────────────────────────── -->
@{
    var history = ViewBag.History as List<TaskFlow.Models.WorkItemHistory> ?? new List<TaskFlow.Models.WorkItemHistory>();
}
@if (history.Any())
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Change History</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Field</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Changed By</th>
                            <th>When</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in history)
                        {
                            <tr>
                                <td class="fw-semibold small">@entry.Field</td>
                                <td class="text-muted small">@(entry.OldValue ?? "—")</td>
                                <td class="small">@(entry.NewValue ?? "—")</td>
                                <td class="text-muted small">@(entry.ChangedBy?.FullName ?? "System")</td>
                                <td class="text-muted small">@entry.ChangedAt.ToString("MMM d, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

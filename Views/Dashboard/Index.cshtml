@model TaskFlow.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var statusLabels   = JsonSerializer.Serialize(Model.ByStatus.Keys.ToList());
    var statusData     = JsonSerializer.Serialize(Model.ByStatus.Values.ToList());
    var priorityLabels = JsonSerializer.Serialize(Model.ByPriority.Keys.ToList());
    var priorityData   = JsonSerializer.Serialize(Model.ByPriority.Values.ToList());
    var projectLabels  = JsonSerializer.Serialize(Model.ByProject.Keys.ToList());
    var projectData    = JsonSerializer.Serialize(Model.ByProject.Values.ToList());
}

<h3 class="mb-4">Dashboard</h3>

<!-- ── Summary Cards ───────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-1">📁</div>
                <div>
                    <div class="fs-2 fw-bold text-primary">@Model.TotalProjects</div>
                    <div class="text-muted small">Total Projects</div>
                    <div class="text-success small">@Model.ActiveProjects active</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-1">📋</div>
                <div>
                    <div class="fs-2 fw-bold text-secondary">@Model.TotalItems</div>
                    <div class="text-muted small">Total Work Items</div>
                    <div class="text-warning small">@Model.OpenItems open</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-1">⏰</div>
                <div>
                    <div class="fs-2 fw-bold text-danger">@Model.ItemsDueThisWeek</div>
                    <div class="text-muted small">Due This Week</div>
                    <div class="text-muted small">next 7 days</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="fs-1">✅</div>
                <div>
                    <div class="fs-2 fw-bold text-success">@Model.ItemsDoneToday</div>
                    <div class="text-muted small">Completed Today</div>
                    <div class="text-muted small">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase small fw-semibold">Items by Status</h6>
                <canvas id="statusChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase small fw-semibold">Items by Priority</h6>
                <canvas id="priorityChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase small fw-semibold">Items per Project</h6>
                <canvas id="projectChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ── Recent Activity ────────────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h6 class="card-title text-muted text-uppercase small fw-semibold mb-3">Recent Activity</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Project</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentItems)
                    {
                        <tr>
                            <td>
                                <a asp-controller="WorkItems" asp-action="Detail" asp-route-id="@item.WorkItemId"
                                   class="text-decoration-none fw-semibold">@item.Title</a>
                            </td>
                            <td class="text-muted small">@item.ProjectName</td>
                            <td>
                                @{
                                    var pBadge = item.Priority == "Critical" ? "bg-danger"
                                               : item.Priority == "High"     ? "bg-warning text-dark"
                                               : item.Priority == "Medium"   ? "bg-info text-dark"
                                               : "bg-secondary";
                                }
                                <span class="badge @pBadge">@item.Priority</span>
                            </td>
                            <td>
                                @{
                                    var sBadge = item.Status == "Done"       ? "bg-success"
                                               : item.Status == "InProgress" ? "bg-primary"
                                               : item.Status == "InReview"   ? "bg-info text-dark"
                                               : "bg-light text-dark border";
                                    var sLabel = item.Status == "InProgress" ? "In Progress"
                                               : item.Status == "InReview"   ? "In Review"
                                               : item.Status;
                                }
                                <span class="badge @sBadge">@sLabel</span>
                            </td>
                            <td class="text-muted small">@item.UpdatedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // ── Status doughnut ─────────────────────────────────────────────────────────
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(statusLabels),
            datasets: [{
                data: @Html.Raw(statusData),
                backgroundColor: ['#dee2e6','#0d6efd','#0dcaf0','#198754']
            }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
    });

    // ── Priority bar ────────────────────────────────────────────────────────────
    new Chart(document.getElementById('priorityChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(priorityLabels),
            datasets: [{
                label: 'Items',
                data: @Html.Raw(priorityData),
                backgroundColor: ['#6c757d','#0dcaf0','#ffc107','#dc3545']
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });

    // ── Per-project horizontal bar ───────────────────────────────────────────────
    new Chart(document.getElementById('projectChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(projectLabels),
            datasets: [{
                label: 'Work Items',
                data: @Html.Raw(projectData),
                backgroundColor: '#0d6efd'
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}

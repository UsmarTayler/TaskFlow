@model TaskFlow.ViewModels.ErrorViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="display-1 fw-bold text-muted mb-3">@Model.StatusCode</div>
        <h2 class="mb-3">@Model.Title</h2>
        <p class="text-muted mb-4">@Model.Message</p>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                Go to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                Go Back
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-5">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>

@model TaskFlow.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h3 class="mb-4">My Profile</h3>

        <!-- Stats row -->
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-primary">@Model.TasksAssigned</div>
                    <div class="text-muted small">Tasks Assigned</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-success">@Model.TasksCompleted</div>
                    <div class="text-muted small">Completed</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-secondary">
                        @(Model.TasksAssigned == 0 ? 0 : (int)Math.Round(Model.TasksCompleted * 100.0 / Model.TasksAssigned))%
                    </div>
                    <div class="text-muted small">Done Rate</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <!-- Account info (read-only) -->
                <div class="mb-4">
                    <div class="mb-2">
                        <span class="text-muted small">Email</span>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                    <div>
                        <span class="text-muted small">Role</span>
                        <div>
                            @foreach (var role in Model.Roles)
                            {
                                var badge = role == "Admin"          ? "bg-danger"
                                          : role == "ProjectManager" ? "bg-primary"
                                          : "bg-success";
                                <span class="badge @badge me-1">@role</span>
                            }
                        </div>
                    </div>
                </div>

                <hr />

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <!-- Name -->
                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase small fw-semibold mb-3">Account Details</h6>
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <hr />

                    <!-- Password change -->
                    <div class="mb-3">
                        <h6 class="text-muted text-uppercase small fw-semibold mb-3">
                            Change Password
                            <span class="fw-normal text-muted">(leave blank to keep current)</span>
                        </h6>
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentPassword" class="form-control" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

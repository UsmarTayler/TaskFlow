@model string?

@{
    ViewData["Title"] = "Check Your Email";
    var resetLink = Model;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="text-center mb-4">
            <h2 class="fw-bold"><span class="text-primary">Task</span>Flow</h2>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <div style="font-size:2.5rem" class="mb-2">📬</div>
                <h5 class="fw-semibold mb-2">Reset link generated</h5>

                @if (resetLink != null)
                {
                    <!-- In production this link would be sent by email.
                         Displayed here because no mail server is configured in this demo. -->
                    <p class="text-muted small mb-3">
                        In a production deployment this link would arrive in your inbox.
                        For this demo it is shown directly below — click it to set a new password.
                    </p>
                    <div class="alert alert-info text-start small p-3">
                        <div class="fw-semibold mb-1">Your password reset link:</div>
                        <a href="@resetLink" class="text-break">@resetLink</a>
                    </div>
                }
                else
                {
                    <p class="text-muted small">
                        If an account exists for that email address, a reset link has been sent.
                        Please check your inbox (and spam folder).
                    </p>
                }

                <a asp-action="Login" class="btn btn-outline-secondary btn-sm mt-2">← Back to login</a>
            </div>
        </div>
    </div>
</div>

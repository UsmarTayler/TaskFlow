@{
    ViewData["Title"] = "Password Reset";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold"><span class="text-primary">Task</span>Flow</h2>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <div style="font-size:2.5rem" class="mb-2">✅</div>
                <h5 class="fw-semibold mb-2">Password updated</h5>
                <p class="text-muted small mb-4">
                    Your password has been reset successfully. You can now sign in with your new password.
                </p>
                <a asp-action="Login" class="btn btn-primary">Go to Login</a>
            </div>
        </div>
    </div>
</div>

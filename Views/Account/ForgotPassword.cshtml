@model TaskFlow.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold"><span class="text-primary">Task</span>Flow</h2>
            <p class="text-muted">Reset your password</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    Enter the email address linked to your account and we'll send you a reset link.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com"
                               autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                </form>

                <div class="text-center mt-3 small">
                    <a asp-action="Login" class="text-decoration-none">← Back to login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
